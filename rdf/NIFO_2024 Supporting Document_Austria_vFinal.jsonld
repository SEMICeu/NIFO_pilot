          "@id": "https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/interoperability-initiatives-austria"
        }
      ],
      "http://purl.org/dc/terms/relation": [
        {
          "@id": "https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/interoperability-initiatives-austria"
        }
